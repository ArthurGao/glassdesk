            "type": "string",
            "title": "Kind"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified"
          }
        },
        "type": "object",
        "required": [
          "n",
          "item_id",
          "kind",
          "title",
          "source",
          "text",
          "verified"
        ],
        "title": "Citation"
      },
      "ConversationOut": {
        "properties": {
