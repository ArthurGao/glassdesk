  "components": {
    "schemas": {
      "AcceptIn": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "personal",
              "team"
            ],
            "title": "Scope",
            "default": "team"
          }
        },
        "type": "object",
        "title": "AcceptIn"
      },
      "Answer": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "failed": {
            "type": "boolean",
            "title": "Failed"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "unmatched": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Unmatched"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "question",
          "text",
          "failed",
          "citations",
          "unmatched"
        ],
        "title": "Answer"
      },
      "Body_upload_document": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document"
      },
      "Branding": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "welcome": {
            "type": "string",
            "title": "Welcome"
          },
          "examples": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Examples"
          }
        },
        "type": "object",
        "required": [
          "name",
          "color",
          "welcome",
          "examples"
        ],
        "title": "Branding"
      },
      "CandidateOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "stage",
          "risk_level",
          "title",
          "content",
          "reason",
          "origin",
          "created_at"
        ],
        "title": "CandidateOut"
      },
      "CardOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "content",
          "risk_level",
          "reason"
