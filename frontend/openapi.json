    "/api/conversations/{conversation_id}/answers/{run_id}/feedback": {
      "post": {
        "summary": "Rate Answer",
        "description": "The user's verdict on one answer: kept here (one per user, the latest wins) and passed to\nsteward for every item the answer cited, best effort.",
        "operationId": "rate_answer",
        "parameters": [
