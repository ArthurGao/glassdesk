# glassdesk backend settings (prefix GLASSDESK_). Copy to backend/.env; never commit .env.
GLASSDESK_DATABASE_URL=postgresql+psycopg://glassdesk:CHANGE_ME@localhost:5432/glassdesk
# Tests only: same database, schemas glassdesk_test / lite_agent_test (dropped and recreated by the fixtures)
GLASSDESK_TEST_DATABASE_URL=postgresql+psycopg://glassdesk:CHANGE_ME@localhost:5432/glassdesk
GLASSDESK_STEWARD_URL=http://127.0.0.1:8600
GLASSDESK_STEWARD_API_KEY=stw_CHANGE_ME
GLASSDESK_STEWARD_REVIEW_KEY=stw_CHANGE_ME
# At least 32 characters; signs the login cookie
GLASSDESK_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_32_PLUS
GLASSDESK_BRAND_NAME=glassdesk
# lite-model (design §8): the agent's role is desk.answer
GLASSDESK_LLM__BACKEND=ollama
GLASSDESK_LLM__MODEL=qwen3:8b
# GLASSDESK_LLM__ROLES={"desk.answer": {"model": "qwen3:8b"}}
