# One customer's deployment. bootstrap.sh fills in every secret and key below the line; edit the
# rest before running it. Never commit the resulting .env.

# The customer
BRAND_NAME=示例科技 知识台
BRAND_COLOR="#0f766e"
BRAND_WELCOME=问我公司制度、流程和常见问题。回答会标出处，右边能看到我每一步做了什么。
BRAND_EXAMPLES=["出差住宿上限是多少？", "报销要在多久内提交？", "年假怎么算？"]
TIMEZONE=Asia/Shanghai

# Models (Ollama). Unset OLLAMA_URL: the bundled Ollama container.
CHAT_MODEL=qwen3:8b
# OLLAMA_URL=http://host.docker.internal:11434

# Where glassdesk listens on this host (loopback only; a TLS proxy in front for everyone else)
GLASSDESK_PORT=8740
# Behind a TLS-terminating proxy:
# GLASSDESK_SERVE_FLAGS=--proxy-headers

# ---- filled in by bootstrap.sh ----
